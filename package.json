{
  "name": "spicesync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify": "npm run verify:quiz && npm run verify:flow && npm run verify:psych",
    "verify:quiz": "node --experimental-strip-types src/lib/food/verify-quiz.ts",
    "verify:flow": "node --experimental-strip-types src/lib/food/verify-flow.ts",
    "verify:psych": "node --experimental-strip-types src/lib/psych/verify-psych.ts",
    "calibrate": "node --experimental-strip-types src/lib/food/calibrate-pool.ts > src/lib/food/pool-calibration.next.ts && mv src/lib/food/pool-calibration.next.ts src/lib/food/pool-calibration.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.0"
  }
}
