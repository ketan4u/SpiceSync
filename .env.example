# Supabase — Project Settings → Data API
# Neither is prefixed NEXT_PUBLIC_, so neither reaches the browser.
# The anon key is safe here: row-level security restricts it to INSERT on
# `waitlist` only, so it cannot read the list back.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
