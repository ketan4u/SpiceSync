# Supabase — Project Settings → API Keys
#
# The NEXT_PUBLIC_ pair is sent to the browser. That is required: Supabase Auth
# runs client-side. It is safe only because row-level security is enforced on
# every table — see supabase/migrations. Never put the service_role/secret key
# in any of these.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only copies, used by the waitlist action. Same values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role. SERVER ONLY - never prefix this NEXT_PUBLIC_, never paste it
# into a client file, never share it. It bypasses row-level security entirely.
# Ranking needs it because the scorer must read candidates' answers, which RLS
# rightly forbids any user from doing. Without it the feed falls back to the
# seeded demo profiles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phone OTP is implemented but off. Turning it on needs an SMS provider AND
# DLT registration with an Indian telecom operator, or codes are not delivered.
AUTH_PHONE_ENABLED=false
